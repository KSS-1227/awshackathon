# =============================================================
# Enterprise Compliance Intelligence Platform — Environment Config
# =============================================================
# Copy this file to backend/.env and fill in your actual values.
# Never commit .env to git.
# =============================================================

# ===== LLM PROVIDER & CONFIG =====
# Supports: bedrock (AWS), gemini (Google), openai (OpenAI-compatible)
# Default: gemini (free tier, recommended for personal projects)

LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_account_1_here
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-3.6-flash

# ===== MULTIMODAL/VISION LLM CONFIG =====
# Can use DIFFERENT provider/account from LLM for independent quota
# Gemini free tier is per-account, so using separate accounts doubles quota

MM_PROVIDER=gemini
MM_API_KEY=your_gemini_api_key_account_2_here
MM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
MM_MODEL_NAME=gemini-3.6-flash

# ===== EMBEDDING MODEL CONFIG =====
# Default reuses LLM_API_KEY (account 1) — set EMBEDDING_API_KEY to use different account
# Gemini embeddings are 768-dim (vs Bedrock Titan's 1024-dim)

EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_api_key_account_1_here
EMBEDDING_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# ===== AUDIO / OPENAI WHISPER =====
# Whisper transcription — uses OpenAI (no Gemini equivalent)
# Optional: leave empty if not using audio transcription

OPENAI_API_KEY=your_openai_api_key_here

# ===== BEDROCK FALLBACK (Legacy, when LLM_PROVIDER=bedrock) =====
# Only needed if switching back to AWS Bedrock
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ===== DIRECTORY PATHS (relative to project root) =====
INPUT_PDF_PATH=data/input/
CACHE_PATH=data/cache
WORKING_DIR=data/working
OUTPUT_DIR=data/output
MMKG_NAME=example_mmkg

# ===== PROCESSING PARAMETERS =====
USE_MINERU=false
ENTITY_EXTRACT_MAX_GLEANING=0
ENTITY_SUMMARY_MAX_TOKENS=500
SUMMARY_CONTEXT_MAX_TOKENS=10000

# ===== RETRIEVAL PARAMETERS =====
RETRIEVAL_THRESHOLD=0.2

# ===== SUPABASE AUTH =====
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== AWS S3 DOCUMENT STORAGE (Optional) =====
DOCUMENT_STORAGE_BACKEND=local
AWS_REGION=ap-south-1
S3_DOCUMENT_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== DYNAMODB CONFIGURATION (Optional) =====
DYNAMODB_TABLE_NAME=compliance-platform
VECTOR_SEARCH_BACKEND=networkx

